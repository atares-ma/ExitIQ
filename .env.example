# Copy to .env.local for local development. Never commit .env.local.
#
# Anything prefixed VITE_ is inlined into the public JavaScript bundle. Only put
# values here that are safe to publish. The Supabase publishable key qualifies:
# Row Level Security is what protects the data. A secret / service-role key never does.
VITE_SUPABASE_URL=https://elpjwoujqzskgydytvob.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_PoJzvUpZYg_QJ0r7FIGYGQ_9GKwsSWA

# Cloudflare Turnstile SITE key (public). Required because CAPTCHA protection is
# enabled for the Supabase project: without it, anonymous sign-in is rejected and
# the app only saves in the browser. The Turnstile SECRET key belongs only in
# Supabase → Authentication → Attack Protection, never here.
VITE_TURNSTILE_SITE_KEY=
